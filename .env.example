# Copy to .env and fill in. Never commit .env.

# --- Supabase (Bridgit project only, not live MA DB) ---
# Dashboard → Bridgit project → Project Settings → API
# Project URL only: https://xxxx.supabase.co
# Do not paste /rest/v1 or the postgres connection string.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 1 model) ---
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI (leave empty — not using in Phase 1) ---
OPENAI_API_KEY=

# --- App ---
BRIDGIT_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Client UI at /app (shared with Faraz). Leave empty to block login until set.
# When set, /jobs is also locked (cookie after POST /meta/password-check).
BRIDGIT_PASSWORD=

# Optional extra CORS origins (comma-separated). /app is same-origin so usually empty.
BRIDGIT_CORS_ORIGINS=
